rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Deny all access by default
    match /{document=**} {
      allow read, write: if false;
    }

    // --- GLOBAL HARDENED HELPERS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    function isValidStringList(lst, maxLen) {
      return lst is list && lst.size() <= maxLen && (lst.size() == 0 || lst[0] is string);
    }

    // --- ENTITY VALIDATION HELPERS ---

    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
             data.email is string && data.email.size() <= 150 &&
             data.preferredMode in ['GURU', 'WALI_MURID'] &&
             data.tpqName is string && data.tpqName.size() <= 100 &&
             data.biometricEnabled is bool &&
             data.dailyReminderEnabled is bool &&
             data.dailyReminderHour is int && data.dailyReminderHour >= 0 && data.dailyReminderHour <= 23 &&
             data.dailyReminderMinute is int && data.dailyReminderMinute >= 0 && data.dailyReminderMinute <= 59 &&
             data.weeklyDigestEnabled is bool &&
             data.monthlyAutoReportEnabled is bool &&
             (!('appsScriptUrl' in data) || (data.appsScriptUrl is string && data.appsScriptUrl.size() <= 500)) &&
             (!('githubRepo' in data) || (data.githubRepo is string && data.githubRepo.size() <= 150)) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidSantri(data) {
      return data.teacherId is string && data.teacherId.size() >= 1 && data.teacherId.size() <= 128 &&
             data.teacherName is string && data.teacherName.size() >= 1 && data.teacherName.size() <= 100 &&
             isValidStringList(data.memberUids, 15) &&
             data.teacherId in data.memberUids &&
             isValidStringList(data.parentUids, 10) &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
             data.nis is string && data.nis.size() >= 1 && data.nis.size() <= 30 &&
             data.halaqahClass is string && data.halaqahClass.size() >= 1 && data.halaqahClass.size() <= 60 &&
             data.parentName is string && data.parentName.size() <= 100 &&
             data.parentContact is string && data.parentContact.size() <= 60 &&
             data.shareCode is string && data.shareCode.size() >= 6 && data.shareCode.size() <= 24 && data.shareCode.matches('^[a-zA-Z0-9_\\-]+$') &&
             (!('lastJoinCode' in data) || (data.lastJoinCode is string && data.lastJoinCode.size() <= 24)) &&
             data.xpPoints is int && data.xpPoints >= 0 && data.xpPoints <= 1000000 &&
             data.streakDays is int && data.streakDays >= 0 && data.streakDays <= 36500 &&
             data.completedSurahCount is int && data.completedSurahCount >= 0 && data.completedSurahCount <= 114 &&
             data.avgTajwidScore is number && data.avgTajwidScore >= 0 && data.avgTajwidScore <= 100 &&
             data.attendancePercent is number && data.attendancePercent >= 0 && data.attendancePercent <= 100 &&
             isValidStringList(data.unlockedBadges, 20) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidShareCode(data) {
      return data.santriId is string && data.santriId.size() >= 1 && data.santriId.size() <= 128 &&
             data.teacherId is string && data.teacherId.size() >= 1 && data.teacherId.size() <= 128 &&
             data.santriName is string && data.santriName.size() >= 1 && data.santriName.size() <= 100 &&
             data.halaqahClass is string && data.halaqahClass.size() >= 1 && data.halaqahClass.size() <= 60 &&
             isValidTimestamp(data.createdAt);
    }

    function isValidNilai(data) {
      return data.santriId is string && data.santriId.size() >= 1 && data.santriId.size() <= 128 &&
             data.teacherId is string && data.teacherId.size() >= 1 && data.teacherId.size() <= 128 &&
             isValidStringList(data.memberUids, 15) &&
             data.teacherId in data.memberUids &&
             data.surahNumber is int && data.surahNumber >= 1 && data.surahNumber <= 114 &&
             data.surahName is string && data.surahName.size() >= 1 && data.surahName.size() <= 60 &&
             data.surahArabic is string && data.surahArabic.size() >= 1 && data.surahArabic.size() <= 60 &&
             data.ayahFrom is int && data.ayahFrom >= 1 && data.ayahFrom <= 300 &&
             data.ayahTo is int && data.ayahTo >= data.ayahFrom && data.ayahTo <= 300 &&
             data.hafalanStatus in ['MUMTAZ', 'MURAJAAH', 'PROSES'] &&
             data.scoreKelancaran is int && data.scoreKelancaran >= 0 && data.scoreKelancaran <= 100 &&
             data.scoreMakhraj is int && data.scoreMakhraj >= 0 && data.scoreMakhraj <= 100 &&
             data.scoreHukumTajwid is int && data.scoreHukumTajwid >= 0 && data.scoreHukumTajwid <= 100 &&
             data.scoreMadQalqalah is int && data.scoreMadQalqalah >= 0 && data.scoreMadQalqalah <= 100 &&
             data.scoreFashohah is int && data.scoreFashohah >= 0 && data.scoreFashohah <= 100 &&
             data.totalScore is int && data.totalScore >= 0 && data.totalScore <= 100 &&
             data.notes is string && data.notes.size() <= 300 &&
             data.dateLabel is string && data.dateLabel.size() >= 1 && data.dateLabel.size() <= 30 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidAbsensi(data) {
      return data.santriId is string && data.santriId.size() >= 1 && data.santriId.size() <= 128 &&
             data.teacherId is string && data.teacherId.size() >= 1 && data.teacherId.size() <= 128 &&
             isValidStringList(data.memberUids, 15) &&
             data.teacherId in data.memberUids &&
             data.dateKey is string && data.dateKey.size() == 10 &&
             data.status in ['HADIR', 'IZIN', 'SAKIT', 'ALPHA'] &&
             data.note is string && data.note.size() <= 200 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidMonthlyReport(data) {
      return data.santriId is string && data.santriId.size() >= 1 && data.santriId.size() <= 128 &&
             data.teacherId is string && data.teacherId.size() >= 1 && data.teacherId.size() <= 128 &&
             isValidStringList(data.memberUids, 15) &&
             data.teacherId in data.memberUids &&
             data.monthKey is string && data.monthKey.size() >= 6 && data.monthKey.size() <= 12 &&
             data.monthTitle is string && data.monthTitle.size() >= 1 && data.monthTitle.size() <= 40 &&
             data.santriName is string && data.santriName.size() >= 1 && data.santriName.size() <= 100 &&
             data.totalSetoran is int && data.totalSetoran >= 0 && data.totalSetoran <= 10000 &&
             data.completedSurahs is int && data.completedSurahs >= 0 && data.completedSurahs <= 114 &&
             data.avgHafalanScore is number && data.avgHafalanScore >= 0 && data.avgHafalanScore <= 100 &&
             data.avgTajwidScore is number && data.avgTajwidScore >= 0 && data.avgTajwidScore <= 100 &&
             data.attendancePercent is number && data.attendancePercent >= 0 && data.attendancePercent <= 100 &&
             data.hadirDays is int && data.hadirDays >= 0 && data.hadirDays <= 31 &&
             data.izinDays is int && data.izinDays >= 0 && data.izinDays <= 31 &&
             data.sakitDays is int && data.sakitDays >= 0 && data.sakitDays <= 31 &&
             data.alphaDays is int && data.alphaDays >= 0 && data.alphaDays <= 31 &&
             data.teacherNote is string && data.teacherNote.size() <= 500 &&
             data.sentToParent is bool &&
             data.parentAcknowledged is bool &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    // --- COLLECTION RULES ---

    match /users/{userId} {
      allow get, list: if isSignedIn() && request.auth.uid == userId;

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll([
                         'userId', 'displayName', 'email', 'preferredMode', 'tpqName',
                         'biometricEnabled', 'dailyReminderEnabled', 'dailyReminderHour',
                         'dailyReminderMinute', 'weeklyDigestEnabled', 'monthlyAutoReportEnabled',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'displayName', 'email', 'preferredMode', 'tpqName',
                         'biometricEnabled', 'dailyReminderEnabled', 'dailyReminderHour',
                         'dailyReminderMinute', 'weeklyDigestEnabled', 'monthlyAutoReportEnabled',
                         'appsScriptUrl', 'githubRepo', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidUserProfile(incoming());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().keys().hasOnly([
                         'userId', 'displayName', 'email', 'preferredMode', 'tpqName',
                         'biometricEnabled', 'dailyReminderEnabled', 'dailyReminderHour',
                         'dailyReminderMinute', 'weeklyDigestEnabled', 'monthlyAutoReportEnabled',
                         'appsScriptUrl', 'githubRepo', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidUserProfile(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'displayName', 'preferredMode', 'tpqName', 'biometricEnabled',
                         'dailyReminderEnabled', 'dailyReminderHour', 'dailyReminderMinute',
                         'weeklyDigestEnabled', 'monthlyAutoReportEnabled',
                         'appsScriptUrl', 'githubRepo', 'updatedAt'
                       ]);

      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
    }

    match /share_codes/{code} {
      // Only direct lookup by exact secret code; never list/scrape codes
      allow get: if isSignedIn() && isValidId(code);

      allow create: if isSignedIn() &&
                       isValidId(code) &&
                       incoming().teacherId == request.auth.uid &&
                       incoming().keys().hasAll(['santriId', 'teacherId', 'santriName', 'halaqahClass', 'createdAt']) &&
                       incoming().keys().hasOnly(['santriId', 'teacherId', 'santriName', 'halaqahClass', 'createdAt']) &&
                       isValidShareCode(incoming());

      allow update: if isSignedIn() &&
                       isValidId(code) &&
                       existing().teacherId == request.auth.uid &&
                       incoming().teacherId == existing().teacherId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().keys().hasOnly(['santriId', 'teacherId', 'santriName', 'halaqahClass', 'createdAt']) &&
                       isValidShareCode(incoming());

      allow delete: if isSignedIn() && isValidId(code) && existing().teacherId == request.auth.uid;
    }

    match /santri/{santriId} {
      allow get: if isSignedIn() && isValidId(santriId) && request.auth.uid in existing().memberUids;
      allow list: if isSignedIn() && request.auth.uid in resource.data.memberUids;

      allow create: if isSignedIn() &&
                       isValidId(santriId) &&
                       incoming().teacherId == request.auth.uid &&
                       request.auth.uid in incoming().memberUids &&
                       incoming().keys().hasAll([
                         'teacherId', 'teacherName', 'memberUids', 'parentUids', 'name', 'nis',
                         'halaqahClass', 'parentName', 'parentContact', 'shareCode', 'xpPoints',
                         'streakDays', 'completedSurahCount', 'avgTajwidScore', 'attendancePercent',
                         'unlockedBadges', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'teacherId', 'teacherName', 'memberUids', 'parentUids', 'name', 'nis',
                         'halaqahClass', 'parentName', 'parentContact', 'shareCode', 'lastJoinCode',
                         'xpPoints', 'streakDays', 'completedSurahCount', 'avgTajwidScore',
                         'attendancePercent', 'unlockedBadges', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidSantri(incoming());

      allow update: if isSignedIn() &&
                       isValidId(santriId) &&
                       incoming().teacherId == existing().teacherId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().keys().hasOnly([
                         'teacherId', 'teacherName', 'memberUids', 'parentUids', 'name', 'nis',
                         'halaqahClass', 'parentName', 'parentContact', 'shareCode', 'lastJoinCode',
                         'xpPoints', 'streakDays', 'completedSurahCount', 'avgTajwidScore',
                         'attendancePercent', 'unlockedBadges', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidSantri(incoming()) && (
                         // Action 1: Guru updates santri record and computed statistics
                         (
                           existing().teacherId == request.auth.uid &&
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'name', 'nis', 'halaqahClass', 'teacherName', 'parentName',
                             'parentContact', 'parentUids', 'memberUids', 'xpPoints',
                             'streakDays', 'completedSurahCount', 'avgTajwidScore',
                             'attendancePercent', 'unlockedBadges', 'updatedAt'
                           ])
                         ) ||
                         // Action 2: Wali Murid links themselves using verified secret shareCode
                         (
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'parentUids', 'memberUids', 'lastJoinCode', 'updatedAt'
                           ]) &&
                           incoming().lastJoinCode == existing().shareCode &&
                           exists(/databases/$(database)/documents/share_codes/$(existing().shareCode)) &&
                           request.auth.uid in incoming().memberUids &&
                           request.auth.uid in incoming().parentUids &&
                           incoming().memberUids.hasAll(existing().memberUids) &&
                           incoming().parentUids.hasAll(existing().parentUids) &&
                           incoming().memberUids.size() <= existing().memberUids.size() + 1 &&
                           incoming().parentUids.size() <= existing().parentUids.size() + 1
                         )
                       );

      allow delete: if isSignedIn() && isValidId(santriId) && existing().teacherId == request.auth.uid;

      match /nilai/{nilaiId} {
        allow get: if isSignedIn() && isValidId(santriId) && isValidId(nilaiId) && request.auth.uid in existing().memberUids;
        allow list: if isSignedIn() && request.auth.uid in resource.data.memberUids;

        allow create: if isSignedIn() &&
                         isValidId(santriId) &&
                         isValidId(nilaiId) &&
                         incoming().teacherId == request.auth.uid &&
                         incoming().santriId == santriId &&
                         incoming().keys().hasAll([
                           'santriId', 'teacherId', 'memberUids', 'surahNumber', 'surahName',
                           'surahArabic', 'ayahFrom', 'ayahTo', 'hafalanStatus', 'scoreKelancaran',
                           'scoreMakhraj', 'scoreHukumTajwid', 'scoreMadQalqalah', 'scoreFashohah',
                           'totalScore', 'notes', 'dateLabel', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'santriId', 'teacherId', 'memberUids', 'surahNumber', 'surahName',
                           'surahArabic', 'ayahFrom', 'ayahTo', 'hafalanStatus', 'scoreKelancaran',
                           'scoreMakhraj', 'scoreHukumTajwid', 'scoreMadQalqalah', 'scoreFashohah',
                           'totalScore', 'notes', 'dateLabel', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidNilai(incoming()) &&
                         exists(/databases/$(database)/documents/santri/$(santriId)) &&
                         get(/databases/$(database)/documents/santri/$(santriId)).data.teacherId == request.auth.uid;

        allow update: if isSignedIn() &&
                         isValidId(santriId) &&
                         isValidId(nilaiId) &&
                         existing().teacherId == request.auth.uid &&
                         incoming().teacherId == existing().teacherId &&
                         incoming().santriId == existing().santriId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidNilai(incoming()) &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'memberUids', 'surahNumber', 'surahName', 'surahArabic', 'ayahFrom',
                           'ayahTo', 'hafalanStatus', 'scoreKelancaran', 'scoreMakhraj',
                           'scoreHukumTajwid', 'scoreMadQalqalah', 'scoreFashohah',
                           'totalScore', 'notes', 'dateLabel', 'updatedAt'
                         ]);

        allow delete: if isSignedIn() && isValidId(santriId) && isValidId(nilaiId) && existing().teacherId == request.auth.uid;
      }

      match /absensi/{absensiId} {
        allow get: if isSignedIn() && isValidId(santriId) && isValidId(absensiId) && request.auth.uid in existing().memberUids;
        allow list: if isSignedIn() && request.auth.uid in resource.data.memberUids;

        allow create: if isSignedIn() &&
                         isValidId(santriId) &&
                         isValidId(absensiId) &&
                         incoming().teacherId == request.auth.uid &&
                         incoming().santriId == santriId &&
                         incoming().keys().hasAll([
                           'santriId', 'teacherId', 'memberUids', 'dateKey', 'status',
                           'note', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'santriId', 'teacherId', 'memberUids', 'dateKey', 'status',
                           'note', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidAbsensi(incoming()) &&
                         exists(/databases/$(database)/documents/santri/$(santriId)) &&
                         get(/databases/$(database)/documents/santri/$(santriId)).data.teacherId == request.auth.uid;

        allow update: if isSignedIn() &&
                         isValidId(santriId) &&
                         isValidId(absensiId) &&
                         existing().teacherId == request.auth.uid &&
                         incoming().teacherId == existing().teacherId &&
                         incoming().santriId == existing().santriId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidAbsensi(incoming()) &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'memberUids', 'status', 'note', 'updatedAt'
                         ]);

        allow delete: if isSignedIn() && isValidId(santriId) && isValidId(absensiId) && existing().teacherId == request.auth.uid;
      }

      match /laporan/{laporanId} {
        allow get: if isSignedIn() && isValidId(santriId) && isValidId(laporanId) && request.auth.uid in existing().memberUids;
        allow list: if isSignedIn() && request.auth.uid in resource.data.memberUids;

        allow create: if isSignedIn() &&
                         isValidId(santriId) &&
                         isValidId(laporanId) &&
                         incoming().teacherId == request.auth.uid &&
                         incoming().santriId == santriId &&
                         incoming().keys().hasAll([
                           'santriId', 'teacherId', 'memberUids', 'monthKey', 'monthTitle',
                           'santriName', 'totalSetoran', 'completedSurahs', 'avgHafalanScore',
                           'avgTajwidScore', 'attendancePercent', 'hadirDays', 'izinDays',
                           'sakitDays', 'alphaDays', 'teacherNote', 'sentToParent',
                           'parentAcknowledged', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'santriId', 'teacherId', 'memberUids', 'monthKey', 'monthTitle',
                           'santriName', 'totalSetoran', 'completedSurahs', 'avgHafalanScore',
                           'avgTajwidScore', 'attendancePercent', 'hadirDays', 'izinDays',
                           'sakitDays', 'alphaDays', 'teacherNote', 'sentToParent',
                           'parentAcknowledged', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidMonthlyReport(incoming()) &&
                         exists(/databases/$(database)/documents/santri/$(santriId)) &&
                         get(/databases/$(database)/documents/santri/$(santriId)).data.teacherId == request.auth.uid;

        allow update: if isSignedIn() &&
                         isValidId(santriId) &&
                         isValidId(laporanId) &&
                         incoming().teacherId == existing().teacherId &&
                         incoming().santriId == existing().santriId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidMonthlyReport(incoming()) && (
                           (
                             existing().teacherId == request.auth.uid &&
                             incoming().diff(existing()).affectedKeys().hasOnly([
                               'memberUids', 'monthTitle', 'santriName', 'totalSetoran',
                               'completedSurahs', 'avgHafalanScore', 'avgTajwidScore',
                               'attendancePercent', 'hadirDays', 'izinDays', 'sakitDays',
                               'alphaDays', 'teacherNote', 'sentToParent', 'updatedAt'
                             ])
                           ) ||
                           (
                             request.auth.uid in existing().memberUids &&
                             incoming().diff(existing()).affectedKeys().hasOnly([
                               'parentAcknowledged', 'updatedAt'
                             ])
                           )
                         );

        allow delete: if isSignedIn() && isValidId(santriId) && isValidId(laporanId) && existing().teacherId == request.auth.uid;
      }
    }
  }
}
